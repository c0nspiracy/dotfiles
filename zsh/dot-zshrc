# Required for the (#q...) glob qualifier used by the compinit freshness check
# and the antidote staleness check below.
setopt extended_glob

# Make Homebrew's completions available to zsh
# See https://docs.brew.sh/Shell-Completion
FPATH="$HOMEBREW_PREFIX/share/zsh/site-functions:${FPATH}"

HISTFILE=~/.zsh_history
HISTSIZE=500000
SAVEHIST=$HISTSIZE

# Some OMZ plugins (docker, mise, etc.) write completion caches into $ZSH_CACHE_DIR.
# OMZ used to set this to $ZSH/cache; provide a sane default now that OMZ is gone.
export ZSH_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
[[ -d $ZSH_CACHE_DIR/completions ]] || mkdir -p $ZSH_CACHE_DIR/completions
fpath=($ZSH_CACHE_DIR/completions $fpath)

# Initialise the completion system *before* loading plugins so they can call compdef.
# Rebuild the dump once a day; otherwise skip the validity check for a fast warm start.
autoload -Uz compinit
if [[ -n $ZSH_CACHE_DIR/zcompdump(#qN.mh+24) ]]; then
  compinit -d "$ZSH_CACHE_DIR/zcompdump"
else
  compinit -C -d "$ZSH_CACHE_DIR/zcompdump"
fi

# Load plugins via antidote — generates a static bundle when plugins.txt is newer,
# or when antidote's clone cache is missing/empty (e.g. wiped by a disk-cleanup tool).
# Requires `brew install antidote`.
_zsh_plugins=${ZDOTDIR:-$HOME}/.zsh_plugins
_antidote_home="${ANTIDOTE_HOME:-$HOME/Library/Caches/antidote}"
if [[ ! ${_zsh_plugins}.zsh -nt ${_zsh_plugins}.txt ]] || [[ -z ${_antidote_home}/**/.git(#qND/) ]]; then
  source $HOMEBREW_PREFIX/opt/antidote/share/antidote/antidote.zsh
  antidote bundle <${_zsh_plugins}.txt >|${_zsh_plugins}.zsh
fi
source ${_zsh_plugins}.zsh
unset _antidote_home

# Warn if it's been >90 days since `antidote update` (or initial install).
# A preexec hook refreshes the stamp whenever the user runs `antidote update`.
() {
  local stamp="$ZSH_CACHE_DIR/antidote-updated"
  if [[ ! -e $stamp ]]; then
    touch $stamp
  elif [[ -n $stamp(#qN.mh+2160) ]]; then
    print -P "%F{yellow}[antidote]%f plugins haven't been updated in >90 days — consider running %B\`antidote update\`%b"
  fi
}
autoload -Uz add-zsh-hook
add-zsh-hook preexec _antidote_stamp_on_update
_antidote_stamp_on_update() { [[ $1 == "antidote update"* ]] && touch "$ZSH_CACHE_DIR/antidote-updated" }

# Cache slow `<tool> init zsh` integrations to avoid forking on every shell start.
# Regenerates when the resolved binary path, its mtime, or the command args change.
_zsh_init_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/zsh-init"
[[ -d $_zsh_init_cache_dir ]] || mkdir -p $_zsh_init_cache_dir

_cached_init() {
  # Usage: _cached_init <cache-key> <binary-name> <command...>
  local key=$1 bin=$2
  shift 2
  local binpath=${$(command -v $bin 2>/dev/null):A}
  [[ -z $binpath ]] && return
  local cache=$_zsh_init_cache_dir/$key.zsh
  local marker="# _cached_init: ${(j: :)@}"
  local first_line=""
  [[ -s $cache ]] && IFS= read -r first_line < $cache
  if [[ ! -s $cache || $binpath -nt $cache || $first_line != $marker ]]; then
    { print -r -- "$marker"; "$@" } >| $cache
  fi
  source $cache
}

# Aliases

alias vim=nvim
alias l="eza --icons"
alias ll="eza --long --icons --git"
alias la="eza --long --icons --git --all"
alias lv="NVIM_APPNAME=LazyVim nvim"
alias calude=claude
# claude uses the work account (default ~/.claude); this one uses the personal Pro login
alias claude-personal="CLAUDE_CONFIG_DIR=$HOME/.claude-personal claude"

# Functions

function rspec-docker() {
  docker exec -i -t -e COVERAGE=false -e RAILS_MAX_THREADS=2 $DOCKER_CONTAINER bundle exec rspec --no-profile "$@" 2>/dev/null
}

function rspec-bisect() {
  files=$(xq "$@" -x /testsuite/testcase/@file | sort -u | paste -sd ' ' -)
  seed=$(xq "$@" -x "/testsuite/properties/property[@name='seed']//@value")

  docker exec -i -t -e COVERAGE=false $DOCKER_CONTAINER bundle exec rspec --no-profile --seed $seed --bisect "${=files}" 2>/dev/null
}

# Tool integrations

_cached_init starship starship starship init zsh
_cached_init mise mise mise activate zsh
_cached_init fzf fzf fzf --zsh
source $HOME/source/junegunn/fzf-git/fzf-git.sh
_cached_init zoxide zoxide zoxide init zsh
_cached_init atuin-pty-proxy atuin atuin pty-proxy init # renders atuin's popup without clearing scrollback
_cached_init atuin atuin atuin init zsh
_cached_init atuin-ai atuin atuin ai init zsh # binds `?` on an empty prompt to the AI assistant
source $XDG_CONFIG_HOME/broot/launcher/bash/br

# No CARAPACE_BRIDGES: carapace's native specs already cover every tool we
# actually use (git, docker, kubectl, npm, aws, gh, ssh, ...). Bridging routes
# everything else through a subprocess that re-shells to zsh's own completion
# system just to get what compsys would've given directly — pure overhead,
# and the likely source of intermittent Tab hangs.
# Explicit unset: an old export lingers in the env of any shell/pane started
# before this change (e.g. existing tmux/herdr panes) — a bare removal here
# wouldn't clear an already-inherited value, only stop re-exporting it.
unset CARAPACE_BRIDGES
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
_cached_init carapace carapace carapace _carapace

_cached_init wt wt command wt config shell init zsh

# Keybindings — run after tool inits so the widgets they reference are defined

bindkey -M vicmd v edit-command-line
bindkey -M vicmd '^R' atuin-search-vicmd     # atuin only binds emacs/viins by default

# Vi insert mode lacks the word-related Alt-bindings that emacs mode has.
# Restore the common ones so they work without dropping to normal mode.
bindkey -M viins '^[f' forward-word          # Alt-F: forward by word (also accepts one word of autosuggestion)
bindkey -M viins '^[F' forward-word
bindkey -M viins '^[b' backward-word         # Alt-B: backward by word
bindkey -M viins '^[B' backward-word
bindkey -M viins '^[d' kill-word             # Alt-D: delete next word
bindkey -M viins '^[D' kill-word
bindkey -M viins '^[.' insert-last-word      # Alt-.: insert last argument of previous command (repeat to walk back)
bindkey -M viins '^[^?' backward-kill-word   # Alt-Backspace: delete previous word

# Export all the known keymaps with prefix CTRL-g so it can be mapped in tmux
export FZF_GIT_BINDKEYS=$(bindkey -p '^g')
